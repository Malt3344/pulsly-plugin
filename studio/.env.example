# The natural voice is set up in Pulsly (app.pulsly.co → Settings → Voice): Claude records it
# there with your own ElevenLabs account, so no key is needed here.
#
# Optional, for making videos without Pulsly: your own ElevenLabs API key and voice id.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# The free local voice (used without ElevenLabs): e.g. am_michael, am_adam, af_heart, bm_george.
VOICE=am_michael
# Optional. 1 is normal speed; reels sound best a little faster.
VOICE_SPEED=1.08
