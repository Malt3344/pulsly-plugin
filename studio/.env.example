# The voice. Paste your own ElevenLabs API key here (elevenlabs.io → Developers → API Keys,
# with "Text to Speech" access). Without it, videos use the free local voice.
ELEVENLABS_API_KEY=
# Optional. Any voice id from your ElevenLabs voice library; the default is "Brian".
ELEVENLABS_VOICE_ID=

# Optional, for the free local voice: e.g. am_michael, am_adam, af_heart, bm_george.
VOICE=am_michael
# Optional. 1 is normal speed; reels sound best a little faster.
VOICE_SPEED=1.08
